(global_label "CELL_MON_ALERT_L" (shape bidirectional) (at 320.04 208.28 0) (effects (font (size 0.95 0.95)) (justify right)) (uuid "0c6db645-a4b7-48c4-afa9-86ac9fd9f1b9"))
(text "4S CELL INPUT MAP (TI datasheet Table 7-1):" (at 25.4 30.48 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left)) (uuid "d2375c07-c451-417f-abca-2be786620e04"))
(text "CELL1 = VC1-VC0; CELL2 = VC2-VC1; CELL3 = VC4B-VC3A; CELL4 = VC5-VC4A." (at 25.4 36.83 0) (effects (font (size 1.2 1.2)) (justify left)) (uuid "be272c12-98c3-442c-a00b-4e71a6b6ed5f"))
(text "4S shorts: VC4A=VC4B; VC3A=VC3B=VC2. These are common nets, not omitted pins." (at 25.4 43.18 0) (effects (font (size 1.2 1.2)) (justify left)) (uuid "01a97871-f5c8-473c-bc85-691ad8ad90ce"))
(text "R801-R805 = 10 Ω series; C801-C805 = 220 nF differential / VC0-to-VSS filter candidates." (at 25.4 49.53 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid "b49962d2-14db-4ba2-84e6-3977888ae7a1"))
(text "Input filter values follow the TI BQ76905EVM example; verify with actual tap wiring and open-wire test." (at 25.4 55.88 0) (effects (font (size 1.05 1.05)) (justify left)) (uuid "1eb11985-3169-44ce-b22b-01dc741a407c"))
(text "BAT: diode + 100 Ω + 1 µF. REGSRC: separate diode + 10 Ω + 1 µF. REGOUT: 1 µF." (at 25.4 62.23 0) (effects (font (size 1.05 1.05)) (justify left)) (uuid "25799e84-b047-4366-a6bb-3b29f63bdeef"))
(text "SRP/SRN/TS unused -> VSS. DSG/CHG unused -> NC. Do not connect low-side drivers to high-side P-MOS." (at 25.4 68.58 0) (effects (font (size 1.05 1.05)) (justify left)) (uuid "e6a45e96-4dd9-4cf4-a57c-5e2347a9edfd"))
(text "PWR_FLAG symbols on filtered measurement rails are ERC source markers only; they are not physical components." (at 25.4 228.6 0) (effects (font (size 1 1)) (justify left)) (uuid "2b8a8053-3d32-468a-9d30-1e04d37804fb"))
(text "CELL_MON_PG requires an external supervisor. CELL_CONFIG_VALID is asserted only after host config readback." (at 25.4 234.95 0) (effects (font (size 1 1)) (justify left)) (uuid "0c85172e-9ea7-48c5-8363-996e387c4961"))
(text "Footprint and 1.05 V CUV accuracy/response delay remain unqualified for supercapacitor use." (at 25.4 241.3 0) (effects (font (size 1 1)) (justify left)) (uuid "c4c87fb6-92e1-41d0-8d8a-65fdfab898bd"))
)