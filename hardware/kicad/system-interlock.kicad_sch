(wire (pts (xy 241.3 194.31) (xy 241.3 200.66)) (stroke (width 0) (type default)) (uuid "2d98cfc7-d31d-437d-81f1-680f8e22f155"))
(global_label "GND" (shape bidirectional) (at 241.3 200.66 0) (effects (font (size 0.95 0.95)) (justify right)) (uuid "6045f1fb-3885-4665-b042-db9ef96d8886"))
(text "HARDWARE DISCHARGE INTERLOCK" (at 25.4 30.48 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left)) (uuid "0f31ba95-5693-4a32-8207-114b80f45f41"))
(text "ARM_PERMIT = PACK_UV_OK AND CELL_MON_PG AND CELL_CONFIG_VALID AND CELL_MON_ALERT_L." (at 25.4 36.83 0) (effects (font (size 1.15 1.15)) (justify left)) (uuid "cd4ba78f-7e56-47d7-ad0c-c1639b9a1a91"))
(text "U910 is a positive-edge DFF: D=1; PRE_N=1; CLR_N=ARM_PERMIT. Any unsafe input clears DISCHARGE_ARM asynchronously." (at 25.4 43.18 0) (effects (font (size 1.05 1.05)) (justify left)) (uuid "81e5d83a-d29e-4f53-8443-0bb62bb189dd"))
(text "A held-high MANUAL_ARM_REQ cannot re-arm after a fault: a new low-to-high edge is required after safety recovers." (at 25.4 49.53 0) (effects (font (size 1.05 1.05)) (justify left)) (uuid "b57a1070-d291-4ee6-a5de-6f0656ff91b1"))
(text "TPS3839G33 monitors REGOUT at 3.08 V; RESET releases after a nominal 200 ms power-good delay." (at 25.4 55.88 0) (effects (font (size 1.05 1.05)) (justify left)) (uuid "e2b4c0e5-766f-4859-ab3e-aff9e35b44ab"))
(text "BOOST_EN is delayed about 60 ms after DISCHARGE_ARM by 100 kΩ / 1 µF; D910 discharges the timing node quickly on fault." (at 25.4 62.23 0) (effects (font (size 1.05 1.05)) (justify left)) (uuid "b55ca0be-24c1-4e09-8553-994e60b0c0bd"))
(text "R914/R915 default CELL_CONFIG_VALID and MANUAL_ARM_REQ low. The host must assert config-valid only after full BQ76905 readback." (at 25.4 68.58 0) (effects (font (size 1.05 1.05)) (justify left)) (uuid "72c6fd60-73f2-4c31-a984-dfef6f901c57"))
(text "STARTUP_TIMEOUT / BOOST_READY feedback is not implemented yet; add with the power-MUX/eFuse page before system release." (at 25.4 228.6 0) (effects (font (size 1.05 1.05)) (justify left)) (uuid "090e0cf1-3c40-471b-8177-2f45b6e0e56d"))
(text "This page implements fail-safe ARM latch and delayed BOOST_EN only; it is not a complete backup-transfer controller." (at 25.4 234.95 0) (effects (font (size 1.05 1.05)) (justify left)) (uuid "7a0c8839-10d9-4e39-a2c2-218b11516cba"))
)